# ---------------------------------------------------------------------------
# CloudCols environment variables.
#
# Copy this file to `.env.local` (development) and set real values there.
# NEVER commit `.env*` or any real secret. Server-only secrets must never be
# bundled into the Flutter / web client.
# ---------------------------------------------------------------------------

# --- App base URLs (web client) ---
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com

# Data layer: "mock" (no backend required) or "api" (live providers).
# Switching this flips the repository facade with no UI changes.
# NOTE: the client reads this, so it MUST be NEXT_PUBLIC_* (Next only inlines
# NEXT_PUBLIC_* into the browser bundle). DATA_LAYER is a server-side alias.
NEXT_PUBLIC_DATA_LAYER=mock
DATA_LAYER=mock

# --- Supabase (auth + Postgres metadata) ---
# The public/anon key is safe for the browser. The service-role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Signs staff (admin panel) sessions. REQUIRED in production — admin sign-in
# refuses to work without it. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN_SECRET=

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY

# --- Backblaze B2 (actual file bytes) ---
# Application key id/secret are SERVER ONLY — never exposed to clients.
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_BUCKET=cloudcols-files
B2_ACCESS_KEY_ID=your-b2-application-key-id
B2_SECRET_ACCESS_KEY=your-b2-application-key      # SERVER ONLY
# Public custom domain mapped to the bucket for CDN delivery.
B2_PUBLIC_DOMAIN=files.yourdomain.com

# --- Cloudflare (CDN + Workers for signing/delivery) ---
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token               # SERVER ONLY
CLOUDFLARE_ZONE_ID=your-zone-id
# Worker name that validates signed URLs and proxies to B2.
CLOUDFLARE_WORKER_URL=https://delivery.yourdomain.com

# --- Payments (provider-adapter) ---
# Values are adapter-specific. Keep empty in dev.
PAYMENT_PROVIDER_ADAPTER_URL=
PAYMENT_WEBHOOK_SECRET=

# --- Developer API server (Phase 2 standalone) ---
DEVELOPER_API_BASE_URL=https://api.yourdomain.com/v1
DEVELOPER_API_WORKER_URL=https://api-meta.yourdomain.com

# --- Email (transactional) ---
# provider: console | resend | smtp | custom. If unset/empty → console log (dev-safe).
EMAIL_PROVIDER=resend
EMAIL_FROM=CloudCols <noreply@yourdomain.com>
RESEND_API_KEY=

# --- Signed CDN delivery (Cloudflare Worker) ---
# Server reads these to issue short-TTL tickets. MUST NOT be exposed to browsers.
CDN_TICKET_SECRET=                              # SERVER ONLY — long random secret
CDN_DOMAIN=https://cdn.yourdomain.com           # your worker URL

# --- Background jobs (scheduler token) ---
# Set to protect /api/jobs/run in production. Empty = open (local only).
JOBS_TOKEN=                                     # SERVER ONLY

# --- Inactivity / trash lifecycle policy ---
INACTIVITY_DAYS=90
INACTIVITY_WARNING_DAYS=30
INACTIVITY_FINAL_WARNING_DAYS=15
INACTIVITY_GRACE_DAYS=7
TRASH_RETENTION_DAYS=30

# --- Feature flags / config (business behavior without redeploys) ---
NEXT_PUBLIC_FEATURE_ADS_ENABLED=true
NEXT_PUBLIC_FEATURE_DEVELOPER_PLATFORM_ENABLED=true
NEXT_PUBLIC_FEATURE_MAINTENANCE_MODE=false

# --- Analytics ---
NEXT_PUBLIC_ANALYTICS_BASE_URL=
